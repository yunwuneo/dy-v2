{
  "name": "douyin-downloader",
  "version": "1.0.0",
  "description": "基于 TikHub API 的抖音视频下载器：作品/点赞/收藏下载、轮询监听、Openclaw 集成",
  "type": "module",
  "bin": {
    "douyin-dl": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "user": "node src/cli.js user",
    "download": "node src/cli.js download",
    "watch": "node src/cli.js watch",
    "serve": "node src/cli.js serve",
    "mcp": "node src/cli.js mcp",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "douyin",
    "tikhub",
    "downloader",
